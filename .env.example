# Copy to .env — every value below works as-is for local development.
#   cp .env.example .env && docker compose up -d --build

# --- Flask ---
# For anything non-local:  python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=dev-only-insecure-key
FLASK_ENV=development

# --- Branding ---
# BRAND_LOGO is a path under static/. Empty renders the name as text instead.
BRAND_NAME=Room Booking
BRAND_LOGO=images/logo.png

# --- Database ---
DB_NAME=booking_app
DB_USER=booking
DB_PASSWORD=booking
MYSQL_ROOT_PASSWORD=rootpw

# --- Host ports ---
WEB_PORT=8000
DB_PORT_HOST=3316

# --- Mail (optional) ---
# Left disabled, notification emails are written to the log instead of sent, so
# the whole booking flow works with no SMTP server.
MAIL_ENABLED=false
MAIL_SERVER=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_USE_TLS=true
MAIL_USE_SSL=false
MAIL_DEFAULT_SENDER=no-reply@example.com
ADMIN_EMAIL=admin@example.com
